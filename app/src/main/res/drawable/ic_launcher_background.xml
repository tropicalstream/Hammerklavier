    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <path android:pathData="M0,0h108v108h-108z">
        <aapt:attr name="android:fillColor">
            <gradient android:type="radial" android:centerX="40" android:centerY="34" android:gradientRadius="86">
                <item android:offset="0" android:color="#FF5A3A1E" />
                <item android:offset="0.55" android:color="#FF321E10" />
                <item android:offset="1" android:color="#FF140C06" />
            </gradient>
        </aapt:attr>
    </path>
</vector>
