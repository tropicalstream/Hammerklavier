#!/usr/bin/env python3
"""Shared gradle wrapper for every worktree: at most SLOTS gradle builds run at once on this Mac
(16 GB, 8 cores; eleven concurrent AGP builds would swap it to a standstill).

    tools/gw :app:testDebugUnitTest            # run from any worktree root
    HK_GRADLE_SLOTS=1 tools/gw :app:assembleRelease

Waits for a free slot (a non-blocking flock on /tmp/hk-gradle-slot-N.lock), then runs ./gradlew in
the current directory with the given arguments, holding the slot until gradle exits.
"""
import fcntl, os, subprocess, sys, time

SLOTS = int(os.environ.get("HK_GRADLE_SLOTS", "2"))
t0 = time.time()
held = None
while held is None:
    for i in range(SLOTS):
        f = open("/tmp/hk-gradle-slot-%d.lock" % i, "w")
        try:
            fcntl.flock(f, fcntl.LOCK_EX | fcntl.LOCK_NB)
            held = f
            break
        except BlockingIOError:
            f.close()
    if held is None:
        time.sleep(2)
waited = time.time() - t0
if waited > 3:
    print("[gw] waited %.0f s for a gradle slot" % waited, file=sys.stderr, flush=True)
sys.exit(subprocess.call(["./gradlew", "--console=plain"] + sys.argv[1:]))
